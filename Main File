        "Copper Veinling", 
        "Iron Veinling",
        "Steel Veinling", 
        "Diamond Veinling", 
        "Coal Veinling", 
    ]

    while True: 
        EActions = []
        EHealth = []
        Loot = {}
        PvE = True
        Options = Search(Inventory, Tools)
        if Options == []: 
            print("No Mining Tool Present.")
            continue

        print("Select a Tool:")
        
        for Item in Options: 
            print(f"| {Item}")

        Pickaxe = input("> ").title().strip()
        if Pickaxe == "Exit":
            return
        
        if Pickaxe not in Options: 
            print("Unknown Selection. Try Again.")
            continue


        # Stats: 
        Data = Assets[Pickaxe]
        PHealth = 100
        PStrength = 1 + Data["Strength"]
        PDefense = 0

        Efficiency = Data["Mining Efficiency"]
        ActionType = Data["Action Type"]
        
        Veinling = random.choice(Enemies)
        Data = Assets[Veinling]
        Grouping = Data["Grouping"]
        VAmount = random.randint(Grouping[0], Grouping[1])
        # VAmount = 10 
        SetAmt = VAmount
        ETurn = VAmount

        while ETurn: 
            EHealth.append(10)
            ETurn -= 1
            #print("DEBUG | Setting HP")
        
        EStrength = Data["Strength"]
        EDefense = Data["Defense"]
        
        while PvE:
            # Player's Turn.
            print("=" * 30)
            
            ETurn = VAmount
            
            while ETurn > 0:
                EActions.append(random.choice(["Attack", "Attack", "Attack", "Attack", "Block"]))
                # print("DEBUG | Action Selection")
                # print(f"| EACtions[{ETurn-1}]: {EActions[(ETurn-2)]}")
                ETurn -= 1
                
            n = (VAmount -1)
            PAction = input("Select an Action:\n| Attack [Main Action] \n| Block [Side Action] \n| Flee [Main] \n| Exit\n> ").title().strip()
            print("=" * 30)

            match (PAction): 
                case ("Attack"): 
                    ETurn = VAmount
                    print("Select an Enemy: (Number)")
                    
                    i = SetAmt -1
                    while i >= 0:
                        if EHealth[i] <= 0:
                            print(f"{Veinling} [{i}] (Dead) | {EHealth[i]}")
                            #EHealth[i] = 0
                            pass
                        else: 
                            print(f"{Veinling} [{i}]")
                        ETurn -= 1
                        i -= 1
                    #print(f"DEBUG | V AMT\n| VAMT = {VAmount}")
                    
                    E = int(input("-" * 30 + "\n> "))
                    if E > (SetAmt-1): 
                        print("Enemy not Available.\n")
                        continue
                    if EHealth[E] <= 0:
                        print("Enemy not Available.\n")
                        continue

                    Damage = max(PStrength - EDefense, 0)
                    if EActions[E] == "Block": Damage /= 2
                    EHealth[E] -= Damage
                    if EHealth[E] < 0: EHealth[E] = 0

                    print("-" * 30 +f"\nYou attack {Veinling} [{E}]! ({EHealth[E]})")
                    #print(f"DEBUG | Damage Dealt: {max(PStrength - EDefense, 0)}")
                
                case ("Block"):
                    if EActions[n] == "Attack":
                        print("You block all incoming attacks! (-50% Damage)")
                        PHealth -= (max((EStrength - PDefense) / 2, 0))
                    else: 
                        print("You ready yourself for a block, but nothing happens.\n| Enemy didnt attack.")
                case ("Flee"): 
                    print("You attempt to Flee...")
                    Roll = random.randint(1,2)
                    if Roll == 1: 
                        print("| You Succeed!")
                        PvE = False
                        return
                    else:
                        print("| You Fail.")
                case ("Exit"): 
                    print("Ending Combat...")
                    PvE = False 
                    return
                case _:
                    print("Unknown Input. Try again.")
                    continue
            
            # Enemy Turn
            ETurn = (SetAmt -1)
            VAmount = SetAmt
            
            while ETurn >= 0:
                if EHealth[n] <= 0: 
                    VAmount -= 1
                    #print(f"DEBUG | VAMT2\n| EHealth[{n}] = {EHealth[n]}\n| VAMT = {VAmount}")
                    # Recieve Drops
                    if EHealth[n] == 0:
                        print(f"> {Veinling}[{n}] Defeated!")
                        for Item in Data["Drops"]:
                            Amount = random.randint(Data["Drops"][Item][0], Data["Drops"][Item][1])
                            Loot[Item] = Loot.get(Item, 0) + Amount
                            print(f"| +{Amount}x {Item}")
                        EHealth[n] -= 1
                
                elif EHealth[n] > 0:
                    match (EActions[n]): 
                        case ("Attack"): 
                            Damage = max(EStrength - PDefense, 0)
                            if PAction == "Block": Damage /= 2
                            PHealth -= Damage
                            print(f"> {Veinling} [{n}] Attacks you for {max(EStrength - PDefense, 0)} Damage!\n| HP: {PHealth}")
                        case ("Block"):
                            print(f"> {Veinling} [{n}] blocks all incoming attacks! (-50% Damage)")
                
                else: 
                    print(f"Error | n = {n}")
                    pass
                     
                ETurn -= 1
                n -= 1
                EHealth[n] = int(EHealth[n])

            if PHealth <= 0: 
                print("=" * 30)
                print("> You Die!\n")
                Loot = []
                PvE = False 
                pass 
            elif VAmount == 0:
                print("=" * 30)
                print("> You Win!")
                PvE = False 
                # Drops Recap 
                for Item in Loot:
                    print(f"| +{Loot[Item]}x {Item}")
                    Inventory[Item] = Inventory.get(Item, 0) + Loot[Item]
                print()
                pass 

def DisplayInventory(Inventory):
    InventoryList = []
    n = 1
    for item in Inventory:
        InventoryList.append(item) 

    print("=" * 30)
    for item in InventoryList:
        print(f"{n:2d} | {Inventory[item]}x {item} ")
        n += 1
    return print("=" * 30)

def Menu(Time):
    while True:
        Mode = input("Select an Action:\n| Inventory\n| Fishing\n| Mining\n| Skills\n> ").title().strip()

        match Mode: 
            case ("Inventory"): 
                DisplayInventory(Inventory)
            case ("Fishing"): 
                Fishing(Time)
            case ("Mining"): 
                Mining(Time) 
            case ("Skills"): 
                XPConversion("Skill", "Display")
        
            case _:
                continue 

def DisplayTime(Time):
    while Time[1] > 36: 
        Time[1] -= 36
        Time[0] += 1
    print(f"[D{Time[0]}] | [T{int(Time[1])}]")

