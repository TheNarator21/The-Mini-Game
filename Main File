def Search(Type, Search): # Type = Inventory / Skills
    Result = []
    for item in Type:
        if item in Search:
            Result.append(item)

    return Result

def Fishing(Time):
    FishingRods = [
        "Wooden Fishing Rod",
        "Beginners Rod", 
        "Stone Fishing Rod",
    ]

    FishingPool = [
        "Mud Guppy", "Minnow", "Salmon"
    ]

    TreasurePool = {
        "Iron Ingot": 1, 
        "Iron Nugget": 3,
    }
    
    JunkPool = {
        "String": 3, 
        "Wooden Bowl": 2,
    }
    
    Fishing = True
    Attempts = True 

    while True:
        # Fishing Skill Check
        SkillCheck = Search(Skills, "Fishing")
        
        
        if SkillCheck == []:
            Skills["Fishing"] = [0, -50]
            # Ex = Skills["Fishing"]
            # print(f"Fishing Lv.{Ex[0]} [{Ex[1]}xp]")
        
        Skills["Fishing"][0] = XPConversion("Fishing", "Proficiency")
        Strength = Skills["Fishing"][0]

        # Fishing Rod Check
        Options = Search(Inventory, FishingRods)
        if Options == []: 
            print("No Rod Present.")
            continue

        print("\nSelect a Rod:")
        
        for Item in Options: 
            print(f"| {Item}")

        FishingRod = input("> ").title().strip()
        if FishingRod == "Exit":
            return
        
        if FishingRod not in Options: 
            print("Unknown Selection. Try Again.")
            continue

        Data = Assets[FishingRod] 

        TChance = Data["Treasure Chance"]
        JChance = Data["Junk Chance"]

        Reels = {}
        while Attempts: 
            Roll = random.randint(1,100)
            print("="*30 + "\nSomething catches the line!")
            if Roll <= TChance: 
                Treasures = []

                for Treasure in TreasurePool:
                    Treasures.append(Treasure) 
                Catch = random.choice(Treasures)
                print("Press [Enter] to Reel it in!")

                Cont = input("> Reel")
                print(f"You Reel in a {Catch}!")
                Reels[Catch] = (Reels.get(Catch, 0) + 1)

            elif Roll <= TChance + JChance: 
                Junks = []

                for Junk in JunkPool:
                    Junks.append(Junk) 
                Catch = random.choice(Junks)
                print("Press [Enter] to Reel it in!")

                Cont = input("> Reel")
                print(f"You Reel in a {Catch}!")
                Reels[Catch] = (Reels.get(Catch, 0) + 1)

            else: 
                Strength += Data["Strength"]
                Fish = []
                
                for item in FishingPool:
                    Fish.append(item) 

                Catch = random.choice(Fish)
                FishSTR = Assets[Catch]["Strength"]
                FishingLevel = Skills["Fishing"]
                
                CRoll = random.randint(1, (10 + (5 * int(FishingLevel[0]/5)))) + min(FishingLevel[0], 10)
                # print(f"DEBUG | Condition Roll = {CRoll}")
                # print(f"{FishingLevel[0]}, {FishingLevel[1]}")
                
                if CRoll <= 10:
                    Condition = "Damaged "
                    FishSTR *= .5
                elif CRoll < 26: 
                    Condition = ""
                elif CRoll >= 26: 
                    Condition = "Healthy "
                    FishSTR *= 1.5                
                
                SuccessChance = int((Strength*100) / (FishSTR + Strength)) # ex: 25% Success [76+]

                Fishing = True 
                while Fishing: 
                    print(f"Press [Enter] to Reel it in!\n| %success: {SuccessChance} ({101 - SuccessChance}+)\n" + "-"*30)

                    Cont = input("> Reel")

                    Roll = random.randint(1,100) 
                    if Roll > (101 - SuccessChance): 
                        Catch = Condition + Catch
                        print(f"You Reel in a {Catch}!")
                        
                        Reels[Catch] = (Reels.get(Catch, 0) + 1)
                        Fishing = False
                        
                        XP = 1 
                        Skills["Fishing"][1] += XP
                        XPConversion("Fishing", "Proficiency")

                        
                    else: 
                        if "Struggle" in Assets[Catch]["Skills"]: 
                            print(f"> It Struggles... ({Roll})")
                            Roll = random.randint(1,5)
                            if Roll == 5: 
                                print("| It Gets away!\n")
                                Fishing = False 
                            else:
                                print("| Nothing Happens.\n")
                
            Time[1] += Data["Reel Time"] * 2

            print("="*30)
            DisplayTime(Time)
            print("Catches:")
                  
            for Item in Reels:
                Amount = Reels[Item]
                print(f"| {Item} x{Amount}")
            print("="*30)

            Cont = input("Continue? (Y/N)\n> ").title().strip()
            if Cont == "N":
                Attempts = False 
                for item in Reels: 
                    Inventory[item] = (Reels.get(item)) 

def Mining (Time): 
    Tools = [
