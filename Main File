                    if "Harden" in ESkills:
                        if ESkills["Harden"] > Efficiency: 
                            Damage = 0
                            print("The Veinling *Hardens*, becoming too tough for your Pickaxe!")
                     
                    EHealth[E] -= Damage
                    if EHealth[E] < 0: EHealth[E] = 0

                    print("-" * 30 +f"\nYou attack {Veinling} [{E}]! ({10 * EHealth[E]}%)")
                    #print(f"DEBUG | Damage Dealt: {max(PStrength - EDefense, 0)}")
                
                case ("Block"):
                    if "Attack" in EActions:
                        print("You block all incoming attacks! (-50% Incomming Damage)")
            
                case "Flee" | "Dodge":
                    FleeSuccess = int(101 - ((100 * PSpeed) / (PSpeed+ESpeed)))
                    print(f"You attempt to Flee...\n| ({FleeSuccess}+)")
                    Roll = random.randint(1,100)

                    if Roll >= FleeSuccess: 
                        Time[1] += math.ceil(Turns/5)
                        print(f"| You Succeed! ({Roll})")
                        
                        if PAction == "Flee":
                            PvE = False
                            return
                        else: 
                            Dodge = True 
                            pass
                    else:
                        print(f"| You Fail. ({Roll})")
                case ("Exit"): 
                    print("Ending Combat...")
                    PvE = False 
                    return
                case _:
                    print("Unknown Input. Try again.")
                    continue
            
            # 4 | Enemy Turns
            ETurn = SetAmt
            
            while ETurn > 0:
                if EHealth[ETurn] <= 0:
                    #print(f"DEBUG | VAMT2\n| EHealth[{n}] = {EHealth[n]}\n| VAMT = {VAmount}")
                    # Recieve Drops
                    if EHealth[ETurn] == 0:
                        print(f"> {Veinling}[{ETurn}] Defeated!")
                        for Item in Data["Drops"]:
                            Amount = random.randint(Data["Drops"][Item][0], Data["Drops"][Item][1])
                            Loot[Item] = Loot.get(Item, 0) + Amount
                            print(f"| +{Amount}x {Item}")
                        EHealth[ETurn] -= 1
                
                elif EHealth[ETurn] > 0:
                    Alive += 1
                    match (EActions[ETurn-1]): 
                        case ("Attack"): 
                            Damage = max(EStrength - PDefense, 0)
                            if PAction == "Block": Damage /= 2
                            if PAction == "Dodge": 
                                if Dodge: Damage = 0
                            PHealth -= Damage
                            print(f"> {Veinling} [{ETurn}] Attacks you for {max(EStrength - PDefense, 0)} Damage!\n| HP: {PHealth}")
                        case ("Block"):
                            print(f"> {Veinling} [{ETurn}] blocks all incoming attacks! (-50% Incomming Damage)")
                        case ("Dodge"): 
                            print(f"> {Veinling} [{ETurn}] attempts to dodge all incoming attacks...")
                            if EDodge:
                                print("| and Succeeds! (-100% Incomming Damage)")
                            else: 
                                print("| and Fails! (-0% Incomming Damage)")
                
                else: 
                    print(f"Error | ETurn = {ETurn}")
                    pass
                     
                EHealth[ETurn] = int(EHealth[ETurn])
                ETurn -= 1

            if PHealth <= 0: 
                print("=" * 30)
                print("> You Die!\n")
                Loot = []
                PvE = False 
                pass 
            elif Alive == 0: 
                Inventory = Inventories[Player]
                Time[1] += math.ceil(Turns/5)
                print("=" * 30)
                print("> You Win!")
                PvE = False 
                # Drops Recap 
                for Item in Loot:
                    print(f"| +{Loot[Item]}x {Item}")
                    if Item in Inventory:
                        Inventory[Item][0] += Loot[Item]
                    else: 
                        Inventory[Item] = [Loot[Item], -1]
                pass 

