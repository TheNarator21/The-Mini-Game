def Locations(): 
    WheatPlants = 5
    Wheat = 50 
    HarvestedTime = -6

    if len(Inventories) == 1:
        for x in Inventories:
            Player = x
    else:
        Player = PlayerVerification(Inventories)
    
    while True: 
        #print(f"=== {Location} ===")
        

        Location = input("\nSelect a Location:\n| Center Market\n| Fishing Pond\n| Coal Mine\n| Apple Grove\n| Wheat Barn\nYou may also try Interactions!\n+ Time\n+ Inventory\n+ Crafting\n > ").title().strip()
        
        match Location: 
            case "Arena": 
                print("Surprise! This is unsupported :/")

            case "Center Market": 
                if len(Inventories) == 1:
                    for x in Inventories:
                        Player = x
                else:
                    Player = PlayerVerification(Inventories)
                        
                Inventory = Inventories[Player]
                
                print("\nWelcome to the Center Market! We've got Fish, Wood, Ores, and more!")
                
                while Location == "Center Market": 
                    Purchase = input("What would you like?\n> ").title().strip()
                    if Purchase == "Exit": 
                        Location = "None"
                        continue 
                    elif Purchase not in Assets: 
                        print("Unknown Selection. Try Again!")
                        continue
                    elif "Cost" not in Assets[Purchase]: 
                        print("Item not for Sale.")
                        continue

                    try: 
                        Amount = int(input("How many would you like? (Whole numbers only)\n> "))
                    except ValueError:
                        print("That wasn't a whole number...")
                        continue
                    Cost = Assets[Purchase]["Cost"] * Amount

                    Mode = input("Are you Buying or Selling?\n> ").title().strip()
                    match Mode: 
                        case "Buying": 
                            if (Cost > Inventory["Money"][0]):
                                Money = Inventory["Money"][0]
                                print(f"Insufficient Funds. Try again later! (${Money} / ${Cost})\n")
                                continue

                            Inventory["Money"][0] -= Cost 
                            Money = Inventory["Money"][0]
                            Durability = Assets[Purchase]["Durability"]
                            print(f"+{Amount}x {Purchase}\n| Money: ${Money} (${Money + Cost} --> ${Money})")

                            if Purchase not in Inventory: 
                                Inventory[Purchase] = [Amount, Durability] 
                            else: Inventory[Purchase][0] += Amount 
                        
                        case "Selling":
                            if Purchase not in Inventory: 
                                print("Item Not Found in Inventory")
                                continue 

                            InvAmt = Inventory[Purchase][0]
                            if (InvAmt < Amount):
                                print(f"Insufficient Item. Try again later! (${InvAmt} / ${Amount})\n")
                                continue

                            Inventory["Money"][0] += Cost
                            Money = Inventory["Money"][0]
                            InvAmt -= Amount
                            print(f"-{Amount}x {Purchase}\n| Money: ${Money} (${Money - Cost} --> ${Money})")

            case "Fishing Pond": 
                Fishing(Time) 
            
            case "Coal Mine": 
                Mining(Time)
            
            case "Apple Grove": 
                Felling() 
            
            case "Wheat Barn":
                Barn = True  
                while Barn:
                    print("You walk up to the Wheat Barn, seeing a Farmer and 2 cows.")
