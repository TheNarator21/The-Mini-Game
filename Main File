                            Inventory["Money"][0] -= Cost 
                            Money = Inventory["Money"][0]
                            Durability = Assets[Purchase]["Durability"]
                            print(f"+{Amount}x {Purchase}\n| Money: ${Money} (${Money + Cost} --> ${Money})")

                            if Purchase not in Inventory: 
                                Inventory[Purchase] = [Amount, Durability] 
                            else: Inventory[Purchase][0] += Amount 
                        
                        case "Selling":
                            if Purchase not in Inventory: 
                                print("Item Not Found in Inventory")
                                continue 

                            InvAmt = Inventory[Purchase][0]
                            if (InvAmt < Amount):
                                print(f"Insufficient Item. Try again later! (${InvAmt} / ${Amount})\n")
                                continue

                            Inventory["Money"][0] += Cost
                            InvAmt -= Amount
                            print(f"-{Amount}x {Purchase}\n| Money: ${Money} (${Money - Cost} --> ${Money})")



