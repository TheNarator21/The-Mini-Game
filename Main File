        Data = Assets[Veinling]
        ESkills = Data["Skills"]
        Grouping = Data["Grouping"]
        ESpeed = Data["Speed"]
        EStrength = Data["Strength"]
        EDefense = Data["Defense"]
        
        # SetAmt = 10
        SetAmt = random.randint(Grouping[0], Grouping[1])
        ETurn = SetAmt

        while ETurn: 
            EHealth[ETurn] = 10 
            ETurn -= 1
            # print("DEBUG | Setting HP")

        # ETurn = SetAmt
        # while ETurn: 
        #     print(f"{ETurn} | {EHealth[ETurn]} HP")
        #     ETurn -= 1
        
        
        while PvE:
            # Player's Turn.
            print("=" * 30)
            Dodge = False 
            Alive = 0 
            
            ETurn = SetAmt
            EActions = []
            while ETurn > 0:
                EActions.append(random.choice(["Attack", "Attack", "Attack", "Attack", "Block", "Dodge"]))
                # print("DEBUG | Action Selection")
                # print(f"| EACtions[{ETurn-1}]: {EActions[(ETurn-2)]}")
                ETurn -= 1

            PAction = input("Select an Action:\n| Attack\n| Block\n| Dodge\n| Flee\n| Exit\n> ").title().strip()
            Turns += 1
            print("=" * 30)

            # 3 | Player Turn
            match (PAction): 
                case ("Attack"): 
                    ETurn = SetAmt 
                    print("Select an Enemy: (Number)")
                    
                    i = SetAmt
                    while i > 0:
                        # print(f"\ni = {i}")
                        if EHealth[i] <= 0:
                            print(f"{Veinling} [{i}] (Dead)")
                            #EHealth[i] = 0
                            pass
                        else: 
                            print(f"{Veinling} [{i}] | {(10 * EHealth[i])}%")
                        i -= 1
                    #print(f"DEBUG | V AMT\n| VAMT = {VAmount}")
                    
                    try: 
                        E = int(input("-" * 30 + "\n> "))
                    except ValueError:
                        continue 

                    if E > (SetAmt): 
                        print("Enemy not Available.\n")
                        continue
                    if EHealth[E] <= 0:
                        print("Enemy not Available.\n")
                        continue

                    Damage = max(PStrength - EDefense, 0)
                    #print(f"DEBUG | Damage = {Damage}")
                    if EActions[E-1] == "Block": Damage /= 2
                    elif EActions[E-1] == "Dodge": 
                        EDodge = True 
                        if random.randint(1,100) >= (101 - (ESpeed*100 / (ESpeed + PSpeed))): 
                            Damage = 0
                            EDodge = False 
