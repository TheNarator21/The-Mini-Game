def PlayerVerification(Inventory):
    while True:
        print("\nSelect a Player's File to View:")
        for E in Inventory: 
            print(f"| {E}")
        Player = input("> ").title().strip()
        
        if Player == "Exit":
            pass
        elif Player not in Inventory:
            print("Unknown Player. Try Again.")
            continue

        return str(Player)


def XPConversion(SkillName, Type, Player):
    while True:
        if Player == "None":
            Player = PlayerVerification(Inventories)
        
        L = 0
        XPRequired = 0
        Skill = Skills[Player][SkillName]
        XP = Skill[1]
        match (Type):
            case "Display": 
                SkillName = input("Enter Skill Name:\n> ").title().strip()
                Type = input("Enter Skill Type: (Combat, Magic, Proficiency, etc)\n> ").title().strip()
                continue 
            case "Testing":
                Type = input("Enter Skill Type: (Combat, Magic, Proficiency, etc)\n> ").title().strip() 
                continue

            case "Combat" | "Physical": # Physical are combat-like, without the Max Cap. Ex: Roll & Endurance.
                while XPRequired < (Skill[1] + 1):
                    L += 1
                    XPRequired += round((L**3 + L**2)/6 + (2*L) +3)
                    #print(f"Level = {L}\n| XP Required = {XPRequired}")
            
            case "Magic":
                while XPRequired < (Skill[1] + 1):
                    L += 1
                    XPRequired += .5 * round((L**3 + L**2)/6 + (2*L) +3)
                    #print(f"Level = {L}\n| XP Required = {XPRequired}")

            case "Production":
                while XPRequired < (Skill[1] + 1): # +10
                    L += 1
                    XPRequired += 10 * L 
                    print(f"Level = {L}\n| XP Required = {XPRequired}")

            case "Informational":
                XPRequired = 5
                while XPRequired < (Skill[1] + 1): # +5
                    L += 1
                    XPRequired += 5 * L 
                    #print(f"Level = {L}\n| XP Required = {XPRequired}")
            
            case "Social" | "Proficiency":
                while XPRequired < (Skill[1] + 1): # +20
                    L += 1
                    XPRequired += 20 * L 
                    #print(f"Level = {L}\n| XP Required = {XPRequired}")
            case _:
                print("Unknown Typing")

        if L >= 20:
            if Type in ["Combat"]:
                print("Max Level!")
                L = 20
                XPRequired = 8306
            elif Type == "Production":
                print("Max Level!")
                L = 20
                XPRequired = 2100
        
        if L >= 10:
            if Type == "Proficiency":
                print("Max Level!")
                L = 10
                XPRequired = 1100
            elif Type == "Informational":
                print("Max Level!")
                L = 20
                XPRequired = 280
            elif Type == "Magic": 
                print(f"Tier = {int(L/10) + 1}")
            elif Type == "Social":
                print("Max Level!")
                L = 10
                XPRequired = 1100

        print(f"| {SkillName} Lv.{L} [{XP} / {XPRequired}]")
        return L

def Search(Type, Search, Player): # Type = Inventory / Skills
    Result = []
    if Player == "None":
        Player = PlayerVerification(Inventories)
    elif Player == "Exit": return
    
    for item in Type[Player]:    
        if item in Search:
            Result.append(item)

    return Result

def Fishing(Time):
    FishingRods = [
        "Wooden Fishing Rod",
        "Beginners Rod", 
        "Stone Fishing Rod",
    ]

    FishingPool = [
        "Mud Guppy", "Minnow", "Salmon"
    ]

    TreasurePool = {
        "Iron Ingot": 1, 
        "Iron Nugget": 3,
    }
    
    JunkPool = {
        "String": 3, 
        "Wooden Bowl": 2,
    }

    while True:
        # Fishing Skill Check
        Player = PlayerVerification(Inventories)
        if Player == "Exit":
            return
        SkillCheck = Search(Skills, "Fishing", Player)
        SkillList = Skills[Player]
        
        
        
        if SkillCheck == []:
            SkillList["Fishing"] = [0, -50]
            # Ex = Skills["Fishing"]
            # print(f"Fishing Lv.{Ex[0]} [{Ex[1]}xp]")
        
        SkillList["Fishing"][0] = XPConversion("Fishing", "Proficiency", Player)
        Strength = SkillList["Fishing"][0]

        # Fishing Rod Check
        Options = Search(Inventories, FishingRods, Player)
        if Options == []: 
            print("No Rod Present.")
            return

        print("\nSelect a Rod:")
        
        for Item in Options: 
            print(f"| {Item}")

        FishingRod = input("> ").title().strip()
        if FishingRod == "Exit":
            print("Exiting...")
            return
        
        if FishingRod not in Options: 
            print("Unknown Selection. Try Again.")
            continue

        Attempts = True
        Data = Assets[FishingRod] 

        TChance = Data["Treasure Chance"]
        JChance = Data["Junk Chance"]

        Reels = {}
        while Attempts: 
            Roll = random.randint(1,100)
            print("="*30 + "\nSomething catches the line!")
            if Roll <= TChance: 
                Treasures = []

                for Treasure in TreasurePool:
                    Treasures.append(Treasure) 
                Catch = random.choice(Treasures)
                print("Press [Enter] to Reel it in!")

                Cont = input("> Reel")
                print(f"You Reel in a {Catch}!")
                print(f"DEBUG | Roll = {Roll}")
                
                if Catch in Reels:
                    Reels[Catch][0] += 1
                else: 
                    Reels[Catch] = [1, -1]
                continue

            elif Roll <= TChance + JChance: 
                Junks = []

                for Junk in JunkPool:
                    Junks.append(Junk) 
                Catch = random.choice(Junks)
                print("Press [Enter] to Reel it in!")

                Cont = input("> Reel")
                print(f"You Reel in a {Catch}!")
                print(f"DEBUG | Roll = {Roll}")
                if Catch in Reels:
                    Reels[Catch][0] += 1
                else: 
                    Reels[Catch] = [1, -1]
                continue

            else: 
                Strength += Data["Strength"]
                Fish = []
                
                for item in FishingPool:
                    Fish.append(item) 

                Catch = random.choice(Fish)
                FishSTR = Assets[Catch]["Strength"]
                FishingLevel = SkillList["Fishing"]
                
                CRoll = random.randint(1, (10 + (5 * int(FishingLevel[0]/5)))) + min(FishingLevel[0], 10)
                # print(f"DEBUG | Condition Roll = {CRoll}")
                # print(f"{FishingLevel[0]}, {FishingLevel[1]}")
                
                if CRoll <= 10:
                    Condition = "Damaged "
                    FishSTR *= .5
                elif CRoll < 26: 
                    Condition = ""
                elif CRoll >= 26: 
                    Condition = "Healthy "
                    FishSTR *= 1.5                
                
                SuccessChance = int((Strength*100) / (FishSTR + Strength)) # ex: 25% Success [76+]
                Fishing = True 

                while Fishing: 
                    print(f"Press [Enter] to Reel it in!\n| %success: {SuccessChance} ({101 - SuccessChance}+)\n" + "-"*30)

                    Cont = input("> Reel")

                    Roll = random.randint(1,100) 
                    if Roll > (101 - SuccessChance): 
                        Catch = Condition + Catch
                        print(f"You Reel in a {Catch}!")
                        # print(f"DEBUG | Roll = {Roll}")

                        if Catch in Reels:
                            Reels[Catch][0] += 1
                        else: 
                            Reels[Catch] = [1, -1]
                        Fishing = False
                        # print(f"DEBUG | {Reels[Catch]}: {Reels[Catch][0]}")
                        
                        
                        XP = 1 
                        SkillList["Fishing"][1] += XP
                        XPConversion("Fishing", "Proficiency", Player)

                        
                    else: 
                        if "Struggle" in Assets[Catch]["Skills"]: 
                            print(f"> It Struggles... ({Roll})")
                            Roll = random.randint(1,5)
                            if Roll == 5: 
                                print("| It Gets away!\n")
                                Fishing = False 
                            else:
                                print("| Nothing Happens.\n")
                
            Time[1] += Data["Reel Time"] * 2

            print("="*30)
            DisplayTime(Time)
            print("Catches:")
                  
            for Item in Reels:
                #print(f"===> DEBUG | {Reels[Item][0]}")
                Amount = Reels[Item][0]
                print(f"| {Item} x{Amount}")
            print("="*30)

            Cont = input("Continue? (Y/N)\n> ").title().strip()
            if Cont == "N":
                Attempts = False 
                for item in Reels: 
                    Inventories[Player][item] = (Reels.get(item)) 

def Mining (Time): 
    Tools = [
        "Wooden Pickaxe",
        "Stone Pickaxe",
        "Copper Pickaxe",
        "Iron Pickaxe",
        "Steel Pickaxe",
        "Diamond Pickaxe",
    ]
    
    Enemies = [
        "Copper Veinling", 
        "Iron Veinling",
        "Steel Veinling", 
        "Diamond Veinling", 
        "Coal Veinling", 
    ]

    while True: 
        Turns = 0
        EActions = []
        EHealth = []
        Loot = {}
        PvE = True
        Player = PlayerVerification(Inventories)
        if Player == "Exit": return
        Options = Search(Inventories, Tools, Player)
        if Options == []: 
            print("No Mining Tool Present.")
            continue

        print("Select a Tool:")
        
        for Item in Options: 
            print(f"| {Item}")

        Pickaxe = input("> ").title().strip()
        if Pickaxe == "Exit":
            return
        
        if Pickaxe not in Options: 
            print("Unknown Selection. Try Again.")
            continue


        # Stats: 
        WeaponData = Assets[Pickaxe]
        Efficiency = WeaponData["Mining Efficiency"]
        PStrength = 1 + WeaponData["Strength"]

        PStats = Stats[Player]
        PHealth = PStats["Health"]
        PSpeed = PStats["Speed"]
        PDefense = PStats["Defense"]

        
        Veinling = random.choice(Enemies)
        Data = Assets[Veinling]
        ESkills = Data["Skills"]
        Grouping = Data["Grouping"]
        ESpeed = Data["Speed"]
        VAmount = random.randint(Grouping[0], Grouping[1])
        # VAmount = 10 
        SetAmt = VAmount
        ETurn = VAmount

        while ETurn: 
            EHealth.append(10)
            ETurn -= 1
            #print("DEBUG | Setting HP")
        
        EStrength = Data["Strength"]
        EDefense = Data["Defense"]
        
        while PvE:
            # Player's Turn.
            print("=" * 30)
            Dodge = False 
            
            ETurn = VAmount
            
            while ETurn > 0:
                EActions.append(random.choice(["Attack", "Attack", "Attack", "Attack", "Block", "Dodge"]))
                # print("DEBUG | Action Selection")
                # print(f"| EACtions[{ETurn-1}]: {EActions[(ETurn-2)]}")
                ETurn -= 1
                
            n = (VAmount -1)
            PAction = input("Select an Action:\n| Attack\n| Block\n| Dodge\n| Flee\n| Exit\n> ").title().strip()
            Turns += 1
            print("=" * 30)

            match (PAction): 
                case ("Attack"): 
                    ETurn = VAmount
                    print("Select an Enemy: (Number)")
                    
                    i = SetAmt -1
                    while i >= 0:
                        if EHealth[i] <= 0:
                            print(f"{Veinling} [{i}] (Dead) | {EHealth[i]}")
                            #EHealth[i] = 0
                            pass
                        else: 
                            print(f"{Veinling} [{i}]")
                        ETurn -= 1
                        i -= 1
                    #print(f"DEBUG | V AMT\n| VAMT = {VAmount}")
                    
                    E = int(input("-" * 30 + "\n> "))
                    if E > (SetAmt-1): 
                        print("Enemy not Available.\n")
                        continue
                    if EHealth[E] <= 0:
                        print("Enemy not Available.\n")
                        continue

                    Damage = max(PStrength - EDefense, 0)
                    if EActions[E] == "Block": Damage /= 2
                    # Veinling Special Skill: [Harden]
                    if "Harden" in ESkills:
                        if ESkills["Harden"] > Efficiency: 
                            Damage = 0
                            print("The Veinling *Hardens*, becoming too tough for your Pickaxe!")
                     
                    EHealth[E] -= Damage
                    if EHealth[E] < 0: EHealth[E] = 0

                    print("-" * 30 +f"\nYou attack {Veinling} [{E}]! ({EHealth[E]})")
                    #print(f"DEBUG | Damage Dealt: {max(PStrength - EDefense, 0)}")
                
                case ("Block"):
                    if EActions[n] == "Attack":
                        print("You block all incoming attacks! (-50% Damage)")
                        PHealth -= (max((EStrength - PDefense) / 2, 0))
                    else: 
                        print("You ready yourself for a block, but nothing happens.\n| Enemy didnt attack.")
            
                case "Flee" | "Dodge":
                    FleeSuccess = int(101 - ((100 * PSpeed) / (PSpeed+ESpeed)))
                    print(f"You attempt to Flee...\n| ({FleeSuccess}+)")
                    Roll = random.randint(1,100)

                    if Roll >= FleeSuccess: 
                        Time[1] += math.ceil(Turns/5)
                        print(f"| You Succeed! ({Roll})")
                        
                        if PAction == "Flee":
                            PvE = False
                            return
                        else: 
                            Dodge = True 
                            pass
                    else:
                        print(f"| You Fail. ({Roll})")
                case ("Exit"): 
                    print("Ending Combat...")
                    PvE = False 
                    return
                case _:
                    print("Unknown Input. Try again.")
                    continue
            
            # Enemy Turn
            ETurn = (SetAmt -1)
            VAmount = SetAmt
            
            while ETurn >= 0:
                if EHealth[n] <= 0: 
                    VAmount -= 1
                    #print(f"DEBUG | VAMT2\n| EHealth[{n}] = {EHealth[n]}\n| VAMT = {VAmount}")
                    # Recieve Drops
                    if EHealth[n] == 0:
                        print(f"> {Veinling}[{n}] Defeated!")
                        for Item in Data["Drops"]:
                            Amount = random.randint(Data["Drops"][Item][0], Data["Drops"][Item][1])
                            Loot[Item] = Loot.get(Item, 0) + Amount
                            print(f"| +{Amount}x {Item}")
                        EHealth[n] -= 1
                
                elif EHealth[n] > 0:
                    match (EActions[n]): 
                        case ("Attack"): 
                            Damage = max(EStrength - PDefense, 0)
                            if PAction == "Block": Damage /= 2
                            if PAction == "Dodge": 
                                if Dodge: Damage = 0
                            PHealth -= Damage
                            print(f"> {Veinling} [{n}] Attacks you for {max(EStrength - PDefense, 0)} Damage!\n| HP: {PHealth}")
                        case ("Block"):
                            print(f"> {Veinling} [{n}] blocks all incoming attacks! (-50% Damage)")
                
                else: 
                    print(f"Error | n = {n}")
                    pass
                     
                ETurn -= 1
                n -= 1
                EHealth[n] = int(EHealth[n])

            if PHealth <= 0: 
                print("=" * 30)
                print("> You Die!\n")
                Loot = []
                PvE = False 
                pass 
            elif VAmount == 0:
                Time[1] += math.ceil(Turns/5)
                print("=" * 30)
                print("> You Win!")
                PvE = False 
                # Drops Recap 
                for Item in Loot:
                    print(f"| +{Loot[Item]}x {Item}")
                    Inventories[Item] = Inventories.get(Item, 0) + Loot[Item]
                pass 

def DisplayInventory(Inventory):
    while True:
        print("Select a Player's Inventory to View:")
        for E in Inventory: 
            print(f"| {E}")
        Player = input("> ").title().strip()
        if Player == "Exit": return
        if Player not in Inventory:
            print("Unknown Player. Try Again.")
            continue

        InventoryList = []
        Inventory = Inventory[Player]
        n = 1
        for item in Inventory:
            InventoryList.append(item) 

        print("=" * 30)
        for item in InventoryList:
            #print(f"DEBUG |{item} {Inventory[item]}\n\n")
            if Inventory[item][1] >= 0:
                Durability = f"({Inventory[item][1]})"
            else: 
                Durability = ""
            print(f"{n:2d} | {Inventory[item][0]}x {item} {Durability}")
            n += 1
        return print("=" * 30)

def Menu(Time):
    while True:
        Mode = input("\nSelect an Action:\n| Inventory\n| Fishing\n| Mining\n| Skills\n| Time\n> ").title().strip()

        match Mode: 
            case ("Inventory"): 
                DisplayInventory(Inventories)
            case ("Fishing"): 
                Fishing(Time)
            case ("Mining"): 
                Mining(Time) 
            case ("Skills"): 
                XPConversion("Skill", "Display", "None")
            case ("Time"): 
                DisplayTime(Time)
            case ("Exit"):
                print("\nHave a good day!\n| Exiting...")
                return
            case _:
                continue 

def DisplayTime(Time):
    while Time[1] > 36: 
        Time[1] -= 36
        Time[0] += 1
    print(f"[D{Time[0]}] | [T{int(Time[1])}]")

Menu(Time) 
