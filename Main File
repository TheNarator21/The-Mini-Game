def Crafting(): 
    DisplayInventory(Inventories)
    while True: 
        
        Craftable = True 
        Item = input("\nEnter name of the Item you wish to craft.\n> ").title().strip()
        
        if Item == "Exit": return 
        elif Item == "List": 
            for x in Recipes: 
                print(f"| {x}")
            continue 
        
        elif Item not in Recipes:
            print("Unknown Recipe.")
            continue  
        
        Recipe = Recipes[Item]

        if len(Recipe) == 1: 
            for x in Recipe: 
                Recipe = Recipe[x]
        else: 
            print("Multiple Entries Found. Select one:")
            for x in Recipe: 
                print(f"| {x}")
            Selection = input("> ").title().strip() 
            if Selection in Recipe: 
                Recipe = Recipe[Selection] 
            else: 
                print("Unknown Selection")
                continue 

        Inventory = Inventories["Player"]
        Craftable = True

        Amount = int(input("How many would you like to craft? (Whole number pls)\n> "))
        Amount = abs(Amount) 

        if Amount == 0: 
            print(f"You Craft 0x {Item}!")
            continue 

        for x in Recipe["Materials"]: 
            if (x in Inventory) and ((Recipe["Materials"][x] * Amount) <= Inventory[x][0]):
                pass
            else: 
                Craftable = False
                MAmount = Amount * Recipe["Materials"][x] 
                print(f"| Missing Material: ({MAmount}x {x})")
                continue 


        if Craftable:
            MaterialAmt = Recipe["Amount"] 
            print(f"SUCCESS!\n| +{MaterialAmt * Amount}x {Item}")
            for x in Recipe["Materials"]:
                Material = Recipe["Materials"]
                print(f"| -{Material[x] * Amount}x {x}")
                Inventory[x][0] -= (Recipe["Materials"][x] * Amount)

            if Item in Inventory: 
                Inventory[Item][0] += (Amount * MaterialAmt)
            else: 
                if Item in Assets: 
                    Durability = Assets[Item]["Durability"]
                else: 
                    Durability = -1 
                Inventory[Item] = [(Amount * Recipe["Amount"]), Durability]

            DisplayInventory(Inventories)

def PlayerVerification(Inventory):
    while True:
        print("\nSelect a Player's File to View:")
        for E in Inventory: 
            print(f"| {E}")
        Player = input("> ").title().strip()
        
        if Player == "Exit":
            pass
        elif Player not in Inventory:
            print("Unknown Player. Try Again.")
            continue

        return str(Player)

def XPConversion(SkillName, Type, Player):
    while True:
        if Player == "None":
            
                if len(Inventories) == 1:
                    for x in Inventories:
                        Player = x
                else:
                    Player = PlayerVerification(Inventories)
        
        L = 0
        XPRequired = 0
        Skill = Skills[Player][SkillName]
        XP = Skill[1]
        match (Type):
            case "Display": 
                SkillName = input("Enter Skill Name:\n> ").title().strip()
                Type = input("Enter Skill Type: (Combat, Magic, Proficiency, etc)\n> ").title().strip()
                continue 
            case "Testing":
                Type = input("Enter Skill Type: (Combat, Magic, Proficiency, etc)\n> ").title().strip() 
                continue

            case "Combat" | "Physical": # Physical are combat-like, without the Max Cap. Ex: Roll & Endurance.
                while XPRequired < (Skill[1] + 1):
                    L += 1
                    XPRequired += round((L**3 + L**2)/6 + (2*L) +3)
                    #print(f"Level = {L}\n| XP Required = {XPRequired}")
            
            case "Magic":
                while XPRequired < (Skill[1] + 1):
                    L += 1
                    XPRequired += .5 * round((L**3 + L**2)/6 + (2*L) +3)
                    #print(f"Level = {L}\n| XP Required = {XPRequired}")

            case "Production":
                while XPRequired < (Skill[1] + 1): # +10
                    L += 1
                    XPRequired += 10 * L 
                    print(f"Level = {L}\n| XP Required = {XPRequired}")

            case "Informational":
                XPRequired = 5
                while XPRequired < (Skill[1] + 1): # +5
                    L += 1
                    XPRequired += 5 * L 
                    #print(f"Level = {L}\n| XP Required = {XPRequired}")
            
            case "Social" | "Proficiency":
                while XPRequired < (Skill[1] + 1): # +20
                    L += 1
                    XPRequired += 20 * L 
                    #print(f"Level = {L}\n| XP Required = {XPRequired}")
            case _:
                print("Unknown Typing")

        if L >= 20:
            if Type in ["Combat"]:
                print("Max Level!")
                L = 20
                XPRequired = 8306
            elif Type == "Production":
                print("Max Level!")
                L = 20
                XPRequired = 2100
        
        if L >= 10:
            if Type == "Proficiency":
                print("Max Level!")
                L = 10
                XPRequired = 1100
            elif Type == "Informational":
                print("Max Level!")
                L = 20
                XPRequired = 280
            elif Type == "Magic": 
