        "Iron Ingot": 1, 
        "Iron Nugget": 3,
    }
    
    JunkPool = {
        "String": 3, 
        "Wooden Bowl": 2,
    }

    while True:
        # Fishing Skill Check
        
        if len(Inventories) == 1:
            for x in Inventories:
                Player = x
        else:
            Player = PlayerVerification(Inventories)
        
        if Player == "Exit":
            return
        SkillCheck = Search(Skills, "Fishing", Player)
